# Postgres from compose.local.yml (password = .docker/secrets/db_password). sqlx::test needs CREATEDB, compose user is superuser.
# App + #[sqlx::test] read DATABASE_URL.
DATABASE_URL=postgres://genesy360:CHANGE_ME@127.0.0.1:54320/genesy360
# sqlx query! macros + sqlx-cli read this one (see sqlx.toml). Same value.
GENESY_DATABASE_URL=postgres://genesy360:CHANGE_ME@127.0.0.1:54320/genesy360
# Request pool size (1..=500, default 20)
# DATABASE_MAX_CONNECTIONS=20
BIND_ADDR=0.0.0.0:8080
RUST_LOG=genesy_360_api=debug,tower_http=info
TOKEN_TTL_DAYS=30
# vimdesk-web origin used in email links.
FRONTEND_URL=http://localhost:5173
# This API's public origin (email verification links point here).
API_PUBLIC_URL=http://localhost:8080
# Trusted return origin for web-app-managed Shop connections.
SHOP_PUBLIC_URL=http://localhost:3000
# Mailpit (compose --profile devtools). Prod Postmark: smtp://TOKEN:TOKEN@smtp.postmarkapp.com:587?tls=required
SMTP_URL=smtp://127.0.0.1:1025
# Plain SMTP is refused unless this is true. Local Mailpit only, never in prod.
SMTP_ALLOW_INSECURE=true
MAIL_FROM="Genesy <no-reply@genesy.local>"
# Public auth routes, per client IP: burst, then +1 every N seconds.
RATE_LIMIT_BURST=10
RATE_LIMIT_REPLENISH_SECS=6
# true only behind Traefik (it sets X-Forwarded-For). Exposed directly, clients could fake it.
TRUST_PROXY_HEADERS=false
# Invites one user may create or re-send per hour (mail relay guard).
INVITES_PER_HOUR=20
# Globadyme accounts are workspace settings, sealed under CREDENTIALS_KEY; no provider
# credentials belong here. See docs/api/globadyme.md. Production origin stays gated.
# Operator-owned realm: unset disables Globadyme; only sandbox or production is accepted.
# Staging/production Compose pin this value directly for the API, workers and CLI.
# GLOBADYME_ENVIRONMENT=sandbox
# Legacy clients remain available for historical operations after workspace selection changes.
# Web payments: unset = none (payment intents answer 503). `fake` = in-process test provider,
# debug builds only (a release build refuses to boot with it).
# PAYMENTS_PROVIDER=fake
# Stripe (test mode only in dev: live keys are refused in debug builds). See docs/api/payments.md.
# PAYMENTS_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_API_URL=http://127.0.0.1:12111
# Web orders one workspace may have awaiting payment (fake checkouts can't hold all stock).
CHECKOUT_HOLD_MAX=500
# POST /v1/create-workspace is open (local dev, staging). Unset in production: the first owner
# comes from `genesy-360-api create-owner --email … --workspace …`.
SIGNUP_ENABLED=true
# Server-only assistant bridge HMAC and provider cleanup keys; *_FILE also supported.
# ASSISTANT_BRIDGE_SECRET=
# ELEVENLABS_API_KEY=
# New bulk-run admission is disabled until extraction and 50k load gates pass.
# PRODUCT_BULK_ENABLED=false
# ANTHROPIC_API_KEY=
# ANTHROPIC_API_KEY_FILE=
# Only the staging compose sets this; `genesy-360-api seed-demo` refuses without it.
# GENESY_ALLOW_DEMO_SEED=1
