# Copy to deploy/production/.env.production on the VPS (chmod 600). Never commit the copy.
# Every variable docker-compose.production.yml reads. No secrets here: they are files in secrets/.

# --- The existing Traefik (v3.6, read on the VPS 2026-11-01) ---
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le

# --- Build/version (required) ---
# Image tag: the full sha of a main commit whose `ci` workflow (with its `images` job) passed;
# deploy/deploy.sh writes it.
# Images come from ghcr.io/cotit/genesy-<app>:<sha>.
# Flow takes no variable here: it reaches Office's voice routes at http://office:3000 over the
# internal network, and holds no assistant secret (README "Flow").
GENESY_REF=
# Where deploy.sh gets the images: pull (the CI-built, scanned ones from GHCR) or, as a
# fallback when GHCR is unreachable, build (here, from the checkout).
IMAGE_SOURCE=pull

# --- Mail (required) ---
# Sender on every mail, at the domain verified in Resend. The SMTP server itself is the secret
# file secrets/smtp_url (deploy/set-provider-keys.sh production resend writes it).
MAIL_FROM=Genesy <no-reply@genesy.app>

# --- Optional ---
# Folder holding db_password, database_url, credentials_key, smtp_url and, once Stripe is on,
# stripe_secret_key and stripe_webhook_secret (relative to deploy/production/).
SECRETS_DIR=./secrets

# Admit product imports only after staging verification. Pausing retains workers/cleanup.
# Runtime uses SECRETS_DIR/anthropic_api_key through the optional product-bulk overlay.
PRODUCT_BULK_ENABLED=false
# API log filter.
RUST_LOG=genesy_360_api=info,tower_http=info
# Shop storefront app key (scope catalog:read), made in the office. Empty = shop answers 503.
STOREFRONT_APP_KEY=
# Published home-page renderer; leave off until the design workflow passes staging.
SHOP_DESIGN_ENABLED=false
# File storage origin for shop image CSP. Empty while there is no uploads bucket; once uploads
# are on, docker-compose.uploads.yml sets it to B2_UPLOADS_ENDPOINT.
FILES_ORIGIN=

# Assistant stays disabled until role, secrets and paid release checks have passed.
ASSISTANT_ENABLED=false
# Comma-separated workspace UUIDs; required before enabling new assistant work.
ASSISTANT_WORKSPACE_ALLOWLIST=
ELEVENLABS_AGENT_ID=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=genesy-office-assistant

# --- File uploads (README "Turning on file uploads") ---
# Read only once secrets/b2_uploads_key exists (deploy/set-provider-keys.sh production b2-uploads).
# The existing production bucket and the uploads key's ID (not secret; the key itself is).
# B2_UPLOADS_BUCKET=
# B2_UPLOADS_KEY_ID=
# B2_UPLOADS_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# B2_UPLOADS_REGION=eu-central-003

# --- Stripe ---
# No variables here: keys are secret files, and docker-compose.stripe.yml turns Stripe on
# (README "Turning on Stripe").

# Landing page: the address its "Email us" button opens (default hello@genesy.app, a placeholder).
# CONTACT_EMAIL=
