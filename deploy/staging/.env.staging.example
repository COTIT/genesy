# Copy to deploy/staging/.env.staging on the VPS (chmod 600). Never commit the copy.
# Every variable docker-compose.staging.yml reads. No real values here.

# --- The existing Traefik (v3.6, read on the VPS 2026-11-01) ---
# External Docker network Traefik watches.
TRAEFIK_NETWORK=traefik
# HTTPS entrypoint (`web` only redirects to it).
TRAEFIK_ENTRYPOINT=websecure
# Let's Encrypt resolver (HTTP challenge).
TRAEFIK_CERTRESOLVER=le

# --- Build/version ---
# Image tag: the full sha of a main commit whose `ci` workflow (with its `images` job) passed;
# deploy/deploy.sh writes it.
# Images come from ghcr.io/cotit/genesy-<app>:<sha>-staging for api, office and field.
# Flow takes no variable here: it reaches Office's voice routes at http://office:3000 over the
# internal network, and holds no assistant secret (README "Flow").
GENESY_REF=
# Where deploy.sh gets the images: pull (the CI-built, scanned ones from GHCR) or, as a
# fallback when GHCR is unreachable, build (here, from the checkout).
IMAGE_SOURCE=pull

# --- Optional ---
# Self-signup (new workspaces from the login page). The API defaults to off; staging turns it on.
SIGNUP_ENABLED=true
# Comma-separated CIDRs allowed in (Traefik ipAllowList). Empty = open to everyone.
STAGING_IP_ALLOWLIST=
# Folder holding db_password, database_url, credentials_key and, once Stripe test mode is on,
# stripe_secret_key and stripe_webhook_secret (relative to deploy/staging/).
SECRETS_DIR=./secrets

# Admit product imports only after the release gates pass. Pausing retains workers/cleanup.
# Runtime uses SECRETS_DIR/anthropic_api_key through the optional product-bulk overlay.
PRODUCT_BULK_ENABLED=false
# VPS loopback port for the Mailpit inbox UI (reach it through an ssh tunnel).
MAILPIT_UI_PORT=18025
# API log filter.
RUST_LOG=genesy_360_api=info,tower_http=info
# Shop storefront app key (scope catalog:read), made in the staging office. Empty = shop answers 503.
STOREFRONT_APP_KEY=
# Published home-page renderer; existing home remains the default.
SHOP_DESIGN_ENABLED=false
# File storage origin for shop image CSP. Empty until uploads are on; then
# docker-compose.uploads.yml sets it to the bucket's endpoint (README "Turning on file uploads").
FILES_ORIGIN=

# Assistant stays disabled until role, secrets and paid release checks have passed.
ASSISTANT_ENABLED=false
# Comma-separated workspace UUIDs; required before enabling new assistant work.
ASSISTANT_WORKSPACE_ALLOWLIST=
ELEVENLABS_AGENT_ID=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=genesy-office-assistant-staging
# Staging's own uploads bucket (never production's) and its key ID; the key itself goes to
# secrets/b2_uploads_key through deploy/set-provider-keys.sh staging b2-uploads.
# B2_UPLOADS_BUCKET=
# B2_UPLOADS_KEY_ID=
# B2_UPLOADS_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# B2_UPLOADS_REGION=eu-central-003

# Landing page: the address its "Email us" button opens (default hello@genesy.app, a placeholder).
# CONTACT_EMAIL=
